PORT=3000
# Must stay a loopback address until login exists.
HOST=127.0.0.1
CONNECTIONS_FILE=connections.json
PROFILE_DIR=data/profiles

# Any OpenAI-compatible API, such as OpenRouter, Requesty or a local server.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
# ---- Model ----
# To switch: put # in front of the active MODEL_NAME, remove it from another, and restart.
# Scores and costs measured 2026-11-05, best first. Full results: docs/findings.html
MODEL_TEMPERATURE=0
# DeepSeek V4.1 Flash: 96/96, 3 runs $0.032, list $0.045 in / $0.50 out per million
MODEL_NAME=deepseek/deepseek-v4.1-flash
# Claude Haiku 5.5: 93/96, 3 runs $0.051, list $0.10 in / $0.50 out per million  [needs MODEL_TEMPERATURE=none]
#MODEL_NAME=anthropic/claude-haiku-5.5
# GPT-6 Luna: 92/96, 3 runs $0.016, list $0.10 in / $0.50 out per million  [needs MODEL_TEMPERATURE=none]
#MODEL_NAME=openai/gpt-6-luna
# Qwen3-Coder-Next: 92/96, 3 runs $0.024, list $0.12 in / $0.80 out per million
#MODEL_NAME=qwen/qwen3-coder-next
# GLM 5.3 Flash: 92/96, 3 runs $0.029, list $0.15 in / $0.50 out per million
#MODEL_NAME=z-ai/glm-5.3-flash
# GLM 5.3: 92/96, 3 runs $0.11, list $0.07 in / $1.40 out per million
#MODEL_NAME=z-ai/glm-5.3
# GPT-OSS 120B: 91/96, 3 runs $0.015, list $0.15 in / $0.60 out per million
#MODEL_NAME=openai/gpt-oss-120b
# Claude Sonnet 5.5: 91/96, 3 runs $0.78, list $2.00 in / $10.00 out per million  [needs MODEL_TEMPERATURE=none]
#MODEL_NAME=anthropic/claude-sonnet-5.5
# Gemma 4 26B: 84/96, 3 runs $0.018, list $0.03 in / $0.089 out per million
#MODEL_NAME=google/gemma-4-26b-a4b-it
# Qwen3.6 35B: 67/96, 3 runs $0.14, list $0.10 in / $0.90 out per million
#MODEL_NAME=qwen/qwen3.6-35b-a3b
# Claude Sonnet 5.5 batch: doesn't work here, OpenRouter rejects :batch models on chat and lists no zero-retention endpoint
#MODEL_NAME=anthropic/claude-sonnet-5.5:batch
# ---- End model ----
# OpenRouter only: route only to zero-retention endpoints. Use false for other APIs.
MODEL_REQUIRE_ZDR=true

# Added as each feature is built:
# APP_DB_URL=sqlite://./data/app.db
# SESSION_SECRET=
